{
  "Thymeleaf + Bootstrap page": {
    "prefix": "thpage",
    "description": "Página HTML con Thymeleaf y Bootstrap 5",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"es\" xmlns:th=\"http://www.thymeleaf.org\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "    <title>${1:Título}</title>",
      "    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css\">",
      "</head>",
      "<body>",
      "<div class=\"container py-4\">",
      "    $0",
      "</div>",
      "<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js\"></script>",
      "</body>",
      "</html>"
    ]
  },
  "Thymeleaf table": {
    "prefix": "thtable",
    "body": [
      "<table class=\"table table-striped table-hover\">",
      "    <thead>",
      "    <tr>",
      "        <th>${2:ID}</th>",
      "        <th>${3:Nombre}</th>",
      "    </tr>",
      "    </thead>",
      "    <tbody>",
      "    <tr th:each=\"${1:item} : \\${${4:items}}\">",
      "        <td th:text=\"\\${${1}.id}\"></td>",
      "        <td th:text=\"\\${${1}.${5:nombre}}\"></td>",
      "    </tr>",
      "    </tbody>",
      "</table>"
    ]
  },
  "Thymeleaf form": {
    "prefix": "thform",
    "body": [
      "<form th:action=\"@{/${1:recursos}}\" th:object=\"\\${${2:item}}\" method=\"post\" class=\"needs-validation\">",
      "    <div class=\"mb-3\">",
      "        <label for=\"${3:nombre}\" class=\"form-label\">${4:Nombre}</label>",
      "        <input type=\"text\" th:field=\"*{${3}}\" class=\"form-control\" th:classappend=\"\\${#fields.hasErrors('${3}')} ? 'is-invalid'\">",
      "        <div class=\"invalid-feedback\" th:errors=\"*{${3}}\"></div>",
      "    </div>",
      "    <button type=\"submit\" class=\"btn btn-primary\">Guardar</button>",
      "</form>"
    ]
  },
  "Thymeleaf field": {
    "prefix": "thfield",
    "body": [
      "<div class=\"mb-3\">",
      "    <label for=\"${1:campo}\" class=\"form-label\">${2:Etiqueta}</label>",
      "    <input type=\"${3:text}\" th:field=\"*{${1}}\" class=\"form-control\" th:classappend=\"\\${#fields.hasErrors('${1}')} ? 'is-invalid'\">",
      "    <div class=\"invalid-feedback\" th:errors=\"*{${1}}\"></div>",
      "</div>"
    ]
  },
  "Bootstrap navbar": {
    "prefix": "bsnavbar",
    "body": [
      "<nav class=\"navbar navbar-expand-lg bg-body-tertiary\">",
      "    <div class=\"container\">",
      "        <a class=\"navbar-brand\" th:href=\"@{/}\">${1:App}</a>",
      "        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#nav\">",
      "            <span class=\"navbar-toggler-icon\"></span>",
      "        </button>",
      "        <div class=\"collapse navbar-collapse\" id=\"nav\">",
      "            <ul class=\"navbar-nav ms-auto\">",
      "                <li class=\"nav-item\"><a class=\"nav-link\" th:href=\"@{/${2:inicio}}\">${3:Inicio}</a></li>$0",
      "            </ul>",
      "        </div>",
      "    </div>",
      "</nav>"
    ]
  }
}
